# Variables de entorno de producción para Vite/React
# Nginx proxyará estas rutas al backend via VPC
# IMPORTANTE: estos prefijos reemplazan "http://localhost:PORT"
# El frontend agrega los paths (/citas, /personal/medicos, etc.)

VITE_API_CITAS=/svc/citas
VITE_API_EXPEDIENTES=/svc/expedientes
VITE_API_QUIROFANOS=/svc/quirofanos
VITE_API_PERSONAL=/svc/personal
VITE_API_COMPILER=/svc/compiler
VITE_API_LOGIN=/svc/compiler/api/login
