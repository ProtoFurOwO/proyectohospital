# ═══════════════════════════════════════════════════════════
#  Variables de entorno para el backend hospitalario (Linux)
# ═══════════════════════════════════════════════════════════

# ── Bases de datos (todas corren en Docker en este mismo servidor) ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hospital
MYSQL_PASSWORD=hospital123
MYSQL_DATABASE=citas

POSTGRES_EXPEDIENTES_URL=postgresql://hospital:hospital123@127.0.0.1:5432/expedientes
POSTGRES_URL=postgresql://hospital:hospital123@127.0.0.1:5432/expedientes?sslmode=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=hospital123

# ── Comunicación entre microservicios (todos en localhost) ──
QUIROFANOS_SERVICE_URL=http://127.0.0.1:8003
EXPEDIENTES_SERVICE_URL=http://127.0.0.1:8002
CITAS_API_URL=http://127.0.0.1:8001
QUIROFANOS_API_URL=http://127.0.0.1:8003
PERSONAL_API_URL=http://127.0.0.1:8005
LOG_ANALYZER_URL=http://127.0.0.1:8006/logs
